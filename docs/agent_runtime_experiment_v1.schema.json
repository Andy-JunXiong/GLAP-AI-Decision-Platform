{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glap.example/contracts/agent-runtime-experiment.v1.schema.json",
  "title": "GLAP governed Agent Runtime experiment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "purpose", "business_timezone", "execution_boundary", "scenario", "runtime_contract", "hosts", "evaluation_layers"],
  "properties": {
    "schema_version": {"const": "agent-runtime-experiment.v1"},
    "experiment_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "purpose": {"const": "HOST_PARITY_VALIDATION"},
    "business_timezone": {"const": "Australia/Sydney"},
    "execution_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "network_access_allowed", "operational_writes_allowed", "production_effect"],
      "properties": {
        "mode": {"const": "LOCAL_READ_ONLY"},
        "network_access_allowed": {"const": false},
        "operational_writes_allowed": {"const": false},
        "production_effect": {"const": false}
      }
    },
    "scenario": {"$ref": "#/$defs/scenario"},
    "runtime_contract": {"$ref": "#/$defs/runtimeContract"},
    "hosts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/host"}
    },
    "evaluation_layers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system_correctness", "capability_attribution", "decision_quality", "business_outcome_effect"],
      "properties": {
        "system_correctness": {"const": "EVALUATE"},
        "capability_attribution": {"const": "NOT_EVALUATED"},
        "decision_quality": {"const": "NOT_EVALUATED"},
        "business_outcome_effect": {"const": "NOT_EVALUATED"}
      }
    }
  },
  "$defs": {
    "timestamp": {"type": "string", "format": "date-time"},
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id", "scenario_mode", "cutoff_at", "evidence_classification", "context_key", "evidence", "decision_memory"],
      "properties": {
        "scenario_id": {"type": "string", "minLength": 1},
        "scenario_mode": {"const": "CONTROLLED_SYNTHETIC_REPLAY"},
        "cutoff_at": {"$ref": "#/$defs/timestamp"},
        "evidence_classification": {"const": "SYNTHETIC_ENGINEERING_ONLY"},
        "context_key": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "decision_memory": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/memory"}}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "evidence_type", "available_at", "provenance", "severity"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "evidence_type": {"enum": ["OPERATIONAL_SIGNAL", "EXTERNAL_EVENT"]},
        "available_at": {"$ref": "#/$defs/timestamp"},
        "provenance": {"const": "CONTROLLED_SYNTHETIC"},
        "severity": {"enum": ["LOW", "MEDIUM", "HIGH"]}
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memory_id", "available_at", "provenance", "context_key", "prior_recommendation", "review_status", "outcome_evidence_class"],
      "properties": {
        "memory_id": {"type": "string", "minLength": 1},
        "available_at": {"$ref": "#/$defs/timestamp"},
        "provenance": {"const": "CONTROLLED_SYNTHETIC"},
        "context_key": {"type": "string", "minLength": 1},
        "prior_recommendation": {"enum": ["MONITOR_EVIDENCE", "REQUEST_BOUNDED_REVIEW"]},
        "review_status": {"const": "SYNTHETIC_REVIEWED"},
        "outcome_evidence_class": {"const": "NOT_EVALUATED"}
      }
    },
    "runtimeContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interface_version", "authority_profile", "tools", "budgets", "redaction"],
      "properties": {
        "interface_version": {"const": "agent-runtime.v1"},
        "authority_profile": {"const": "EVALUATION_NO_MUTATION"},
        "tools": {
          "type": "object",
          "additionalProperties": false,
          "required": ["get_evidence", "get_similar_decisions", "propose_action", "request_approval"],
          "properties": {
            "get_evidence": {"$ref": "#/$defs/readTool"},
            "get_similar_decisions": {"$ref": "#/$defs/readTool"},
            "propose_action": {"$ref": "#/$defs/proposalTool"},
            "request_approval": {"$ref": "#/$defs/approvalTool"}
          }
        },
        "budgets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_tool_calls", "max_evidence_items", "max_memory_items", "max_proposal_characters"],
          "properties": {
            "max_tool_calls": {"const": 4},
            "max_evidence_items": {"const": 2},
            "max_memory_items": {"const": 2},
            "max_proposal_characters": {"const": 1024}
          }
        },
        "redaction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entity_identifiers_allowed", "credentials_allowed", "private_origins_allowed"],
          "properties": {
            "entity_identifiers_allowed": {"const": false},
            "credentials_allowed": {"const": false},
            "private_origins_allowed": {"const": false}
          }
        }
      }
    },
    "readTool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "max_calls"],
      "properties": {"mode": {"const": "LOCAL_READ_ONLY"}, "max_calls": {"const": 1}}
    },
    "proposalTool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "max_calls"],
      "properties": {"mode": {"const": "EVALUATION_PROPOSAL_ONLY"}, "max_calls": {"const": 1}}
    },
    "approvalTool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "max_calls"],
      "properties": {"mode": {"const": "SIMULATED_NO_AUTHORITY"}, "max_calls": {"const": 1}}
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_id", "adapter_version", "enabled_capabilities"],
      "properties": {
        "host_id": {"type": "string", "minLength": 1},
        "adapter_version": {"enum": ["deterministic-reference-adapter-a.v1", "independent-registered-adapter.v1"]},
        "enabled_capabilities": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["EXTERNAL_EVIDENCE", "DECISION_MEMORY"]}
        }
      }
    }
  }
}
