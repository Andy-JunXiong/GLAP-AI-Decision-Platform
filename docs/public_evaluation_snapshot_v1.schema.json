{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://andy-junxiong.github.io/GLAP-AI-Decision-Platform/contracts/public-evaluation-snapshot-v1.schema.json",
  "title": "GLAP public aggregate Evaluation snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "evaluation_as_of_date",
    "source_contract",
    "evidence_class",
    "corpus",
    "decision_quality",
    "privacy",
    "claim_boundary",
    "authority"
  ],
  "properties": {
    "schema_version": {"const": "public-evaluation-snapshot.v1"},
    "status": {"const": "available"},
    "evaluation_as_of_date": {"type": "string", "format": "date"},
    "source_contract": {"const": "decision-quality-five-review-corpus-summary.v1"},
    "evidence_class": {"const": "HYBRID_HISTORICAL_REPLAY"},
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_count", "cutoff_count", "complete_review_count", "minimum_review_count", "locked_review_record_count"],
      "properties": {
        "case_count": {"type": "integer", "minimum": 1},
        "cutoff_count": {"type": "integer", "minimum": 1},
        "complete_review_count": {"type": "integer", "minimum": 1},
        "minimum_review_count": {"type": "integer", "minimum": 1},
        "locked_review_record_count": {"type": "integer", "minimum": 1}
      }
    },
    "decision_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "favors_a303_on_count", "no_winner_count", "unanimous_control_tie_count", "minimum_preference_consensus_pct", "non_control_no_winner_comparisons"],
      "properties": {
        "status": {"const": "MIXED"},
        "favors_a303_on_count": {"type": "integer", "minimum": 0},
        "no_winner_count": {"type": "integer", "minimum": 0},
        "unanimous_control_tie_count": {"type": "integer", "minimum": 0},
        "minimum_preference_consensus_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "non_control_no_winner_comparisons": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["case_label", "cutoff_label", "baseline_preference_count", "challenger_preference_count", "preference_consensus_pct", "result"],
            "properties": {
              "case_label": {"type": "string", "minLength": 1},
              "cutoff_label": {"type": "string", "minLength": 1},
              "baseline_preference_count": {"type": "integer", "minimum": 0},
              "challenger_preference_count": {"type": "integer", "minimum": 0},
              "preference_consensus_pct": {"type": "number", "minimum": 0, "maximum": 100},
              "result": {"const": "REVIEWERS_DO_NOT_AGREE"}
            }
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_identifiers_retained", "credentials_retained", "answer_content_retained", "notes_retained", "private_source_artifacts_retained"],
      "properties": {
        "reviewer_identifiers_retained": {"const": false},
        "credentials_retained": {"const": false},
        "answer_content_retained": {"const": false},
        "notes_retained": {"const": false},
        "private_source_artifacts_retained": {"const": false}
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supports", "does_not_support"],
      "properties": {
        "supports": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "does_not_support": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publication_authority_from_snapshot", "aws_write_allowed", "review_mutation_allowed", "action_mutation_allowed", "policy_activation_allowed", "model_promotion_allowed", "production_effect"],
      "properties": {
        "publication_authority_from_snapshot": {"const": false},
        "aws_write_allowed": {"const": false},
        "review_mutation_allowed": {"const": false},
        "action_mutation_allowed": {"const": false},
        "policy_activation_allowed": {"const": false},
        "model_promotion_allowed": {"const": false},
        "production_effect": {"const": false}
      }
    }
  }
}
