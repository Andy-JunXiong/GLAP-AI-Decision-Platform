{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glap.example/contracts/historical-replay-corpus.v1.schema.json",
  "title": "GLAP historical replay corpus v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "status",
    "evidence_classification",
    "selection_policy",
    "benchmark_gate",
    "scenarios",
    "authority",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "historical-replay-corpus.v1"},
    "corpus_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"},
    "status": {"const": "PILOT_NOT_BENCHMARK"},
    "evidence_classification": {"const": "HYBRID_HISTORICAL_REPLAY"},
    "selection_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_version", "frozen_at", "inclusion_criteria", "exclusion_criteria"],
      "properties": {
        "policy_version": {"const": "historical-replay-selection.v1"},
        "frozen_at": {"type": "string", "format": "date-time"},
        "inclusion_criteria": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "exclusion_criteria": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "benchmark_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_scenarios", "minimum_disruption_types", "minimum_regions", "minimum_transport_modes", "minimum_severity_bands", "required_reviews_per_variant"],
      "properties": {
        "minimum_scenarios": {"type": "integer", "minimum": 1},
        "minimum_disruption_types": {"type": "integer", "minimum": 1},
        "minimum_regions": {"type": "integer", "minimum": 1},
        "minimum_transport_modes": {"type": "integer", "minimum": 1},
        "minimum_severity_bands": {"type": "integer", "minimum": 1},
        "required_reviews_per_variant": {"type": "integer", "minimum": 1}
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario_id", "file"],
        "properties": {
          "scenario_id": {"type": "string"},
          "file": {"type": "string", "pattern": "^[a-z0-9_]+\\.json$"}
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "network_access_allowed", "operational_writes_allowed", "production_effect"],
      "properties": {
        "profile": {"const": "EVALUATION_NO_MUTATION"},
        "network_access_allowed": {"const": false},
        "operational_writes_allowed": {"const": false},
        "production_effect": {"const": false}
      }
    },
    "claim_boundary": {"type": "object"}
  }
}
