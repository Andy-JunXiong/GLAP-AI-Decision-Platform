{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glap.example/contracts/formal-story-review-export.v1.schema.json",
  "title": "GLAP formal story review export v1",
  "description": "Private study-owner export from the formal Sites story-v2 collection. Finality is represented by submitted_at plus exactly 30 ANSWER_LOCKED answers; adding a submission-level status requires a new schema version.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "collection_id", "submissions"],
  "properties": {
    "schema_version": {"const": "glap-formal-story-review-export.v1"},
    "collection_id": {"const": "human-evaluation-story.v2"},
    "submissions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/submission"}
    }
  },
  "$defs": {
    "attestations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["independent", "no_conflict", "no_blind_key"],
      "properties": {
        "independent": {"const": true},
        "no_conflict": {"const": true},
        "no_blind_key": {"const": true}
      }
    },
    "judgments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_grounding",
        "risk_detection_and_proportionality",
        "policy_compliance",
        "actionability",
        "authority_compliance"
      ],
      "properties": {
        "evidence_grounding": {"enum": ["OPTION_A", "OPTION_B", "TIE"]},
        "risk_detection_and_proportionality": {"enum": ["OPTION_A", "OPTION_B", "TIE"]},
        "policy_compliance": {"enum": ["OPTION_A", "OPTION_B", "TIE"]},
        "actionability": {"enum": ["OPTION_A", "OPTION_B", "TIE"]},
        "authority_compliance": {"enum": ["OPTION_A", "OPTION_B", "TIE"]}
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_id",
        "package_digest",
        "judgments",
        "preferred",
        "confidence",
        "notes",
        "committed_at",
        "status"
      ],
      "properties": {
        "review_id": {"type": "string", "minLength": 1},
        "package_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "judgments": {"$ref": "#/$defs/judgments"},
        "preferred": {"enum": ["OPTION_A", "OPTION_B", "TIE"]},
        "confidence": {"type": "integer", "minimum": 1, "maximum": 5},
        "notes": {"type": "string", "maxLength": 1000},
        "committed_at": {"type": "string", "format": "date-time"},
        "status": {"const": "ANSWER_LOCKED"}
      }
    },
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_id",
        "submitted_at",
        "collection_id",
        "bundle_id",
        "bundle_digest",
        "attestations",
        "answers"
      ],
      "properties": {
        "reviewer_id": {"type": "string", "pattern": "^reviewer-[a-z0-9][a-z0-9-]{2,63}$"},
        "submitted_at": {"type": "string", "format": "date-time"},
        "collection_id": {"const": "human-evaluation-story.v2"},
        "bundle_id": {"type": "string", "minLength": 1},
        "bundle_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "attestations": {"$ref": "#/$defs/attestations"},
        "answers": {
          "type": "array",
          "minItems": 30,
          "maxItems": 30,
          "items": {"$ref": "#/$defs/answer"}
        }
      }
    }
  }
}
