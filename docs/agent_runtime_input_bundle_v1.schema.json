{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glap.example/contracts/agent-runtime-input-bundle.v1.schema.json",
  "title": "GLAP Agent Runtime content-addressed input bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_sha256", "source_manifest_sha256", "payload"],
  "properties": {
    "schema_version": {"const": "agent-runtime-input-bundle.v1"},
    "bundle_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload_version", "experiment_id", "scenario", "runtime_envelope", "cutoff_inputs"],
      "properties": {
        "payload_version": {"const": "agent-runtime-input-payload.v1"},
        "experiment_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
        "scenario": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scenario_id", "scenario_mode", "cutoff_at", "evidence_classification", "context_key"],
          "properties": {
            "scenario_id": {"type": "string", "minLength": 1},
            "scenario_mode": {"const": "CONTROLLED_SYNTHETIC_REPLAY"},
            "cutoff_at": {"type": "string", "format": "date-time"},
            "evidence_classification": {"const": "SYNTHETIC_ENGINEERING_ONLY"},
            "context_key": {"type": "string", "minLength": 1}
          }
        },
        "runtime_envelope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["interface_version", "authority_profile", "tools", "budgets", "redaction", "enabled_capabilities"],
          "properties": {
            "interface_version": {"const": "agent-runtime.v1"},
            "authority_profile": {"const": "EVALUATION_NO_MUTATION"},
            "tools": {
              "type": "object",
              "additionalProperties": false,
              "required": ["get_evidence", "get_similar_decisions", "propose_action", "request_approval"],
              "properties": {
                "get_evidence": {"$ref": "#/$defs/readTool"},
                "get_similar_decisions": {"$ref": "#/$defs/readTool"},
                "propose_action": {"$ref": "#/$defs/proposalTool"},
                "request_approval": {"$ref": "#/$defs/approvalTool"}
              }
            },
            "budgets": {
              "type": "object",
              "additionalProperties": false,
              "required": ["max_tool_calls", "max_evidence_items", "max_memory_items", "max_proposal_characters"],
              "properties": {
                "max_tool_calls": {"const": 4},
                "max_evidence_items": {"const": 2},
                "max_memory_items": {"const": 2},
                "max_proposal_characters": {"const": 1024}
              }
            },
            "redaction": {
              "type": "object",
              "additionalProperties": false,
              "required": ["entity_identifiers_allowed", "credentials_allowed", "private_origins_allowed"],
              "properties": {
                "entity_identifiers_allowed": {"const": false},
                "credentials_allowed": {"const": false},
                "private_origins_allowed": {"const": false}
              }
            },
            "enabled_capabilities": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {"enum": ["DECISION_MEMORY", "EXTERNAL_EVIDENCE"]}
            }
          }
        },
        "cutoff_inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidence", "decision_memory"],
          "properties": {
            "evidence": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/evidence"}},
            "decision_memory": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/memory"}}
          }
        }
      }
    },
    "readTool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "max_calls"],
      "properties": {"mode": {"const": "LOCAL_READ_ONLY"}, "max_calls": {"const": 1}}
    },
    "proposalTool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "max_calls"],
      "properties": {"mode": {"const": "EVALUATION_PROPOSAL_ONLY"}, "max_calls": {"const": 1}}
    },
    "approvalTool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "max_calls"],
      "properties": {"mode": {"const": "SIMULATED_NO_AUTHORITY"}, "max_calls": {"const": 1}}
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "evidence_type", "available_at", "provenance", "severity"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "evidence_type": {"enum": ["OPERATIONAL_SIGNAL", "EXTERNAL_EVENT"]},
        "available_at": {"type": "string", "format": "date-time"},
        "provenance": {"const": "CONTROLLED_SYNTHETIC"},
        "severity": {"enum": ["LOW", "MEDIUM", "HIGH"]}
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memory_id", "available_at", "provenance", "context_key", "prior_recommendation", "review_status", "outcome_evidence_class"],
      "properties": {
        "memory_id": {"type": "string", "minLength": 1},
        "available_at": {"type": "string", "format": "date-time"},
        "provenance": {"const": "CONTROLLED_SYNTHETIC"},
        "context_key": {"type": "string", "minLength": 1},
        "prior_recommendation": {"enum": ["MONITOR_EVIDENCE", "REQUEST_BOUNDED_REVIEW"]},
        "review_status": {"const": "SYNTHETIC_REVIEWED"},
        "outcome_evidence_class": {"const": "NOT_EVALUATED"}
      }
    }
  }
}
