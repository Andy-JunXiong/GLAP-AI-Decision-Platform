{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glap.example/schemas/decision-quality-adjudication-v1.json",
  "title": "GLAP Decision Quality Adjudication Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adjudication_id",
    "record_version",
    "supersedes_record_digest",
    "created_on_sydney_date",
    "source_evidence",
    "adjudication",
    "governance",
    "claim_boundary",
    "authority",
    "operational_mutations",
    "record_digest"
  ],
  "properties": {
    "schema_version": {"const": "decision-quality-adjudication.v1"},
    "adjudication_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{7,127}$"},
    "record_version": {"type": "integer", "minimum": 1},
    "supersedes_record_digest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "created_on_sydney_date": {"type": "string", "format": "date"},
    "source_evidence": {"$ref": "#/$defs/sourceEvidence"},
    "adjudication": {"$ref": "#/$defs/adjudication"},
    "governance": {"$ref": "#/$defs/governance"},
    "claim_boundary": {"$ref": "#/$defs/claimBoundary"},
    "authority": {"$ref": "#/$defs/authority"},
    "operational_mutations": {"const": []},
    "record_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_id", "bundle_digest", "review_id", "package_digest",
        "scenario_id", "cutoff_id", "cutoff_at", "evidence_classification",
        "review_count", "raw_review_result", "raw_review_status",
        "non_tie_preference_count", "maximum_preference_count",
        "preference_consensus_pct", "score_delta"
      ],
      "properties": {
        "bundle_id": {"type": "string", "minLength": 1},
        "bundle_digest": {"$ref": "#/$defs/sha256"},
        "review_id": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
        "package_digest": {"$ref": "#/$defs/sha256"},
        "scenario_id": {"const": "new-zealand-cyclone-gabrielle-roads-2023-v1"},
        "cutoff_id": {"const": "T1_COROMANDEL_HIGHWAY_CLOSURES_CONFIRMED"},
        "cutoff_at": {"type": "string", "format": "date-time"},
        "evidence_classification": {"const": "HYBRID_HISTORICAL_REPLAY"},
        "review_count": {"const": 4},
        "raw_review_result": {"const": "REVIEWERS_DO_NOT_AGREE"},
        "raw_review_status": {"const": "REQUIRES_ADJUDICATION"},
        "non_tie_preference_count": {"const": 4},
        "maximum_preference_count": {"const": 2},
        "preference_consensus_pct": {"const": 50.0},
        "score_delta": {"const": 0.0}
      }
    },
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "resolution", "rationale", "decided_by_named_study_owner", "decided_on_sydney_date"],
      "properties": {
        "status": {"enum": ["PENDING_HUMAN_ADJUDICATION", "RESOLVED_HUMAN_ADJUDICATION"]},
        "resolution": {
          "oneOf": [
            {"type": "null"},
            {"enum": ["RETAIN_INCONCLUSIVE", "FAVORS_BASELINE_A303_OFF", "FAVORS_GLAP_A303_ON"]}
          ]
        },
        "rationale": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 20, "maxLength": 2000}]},
        "decided_by_named_study_owner": {"type": "boolean"},
        "decided_on_sydney_date": {"oneOf": [{"type": "null"}, {"type": "string", "format": "date"}]}
      },
      "oneOf": [
        {
          "properties": {
            "status": {"const": "PENDING_HUMAN_ADJUDICATION"},
            "resolution": {"type": "null"},
            "rationale": {"type": "null"},
            "decided_by_named_study_owner": {"const": false},
            "decided_on_sydney_date": {"type": "null"}
          }
        },
        {
          "properties": {
            "status": {"const": "RESOLVED_HUMAN_ADJUDICATION"},
            "resolution": {"enum": ["RETAIN_INCONCLUSIVE", "FAVORS_BASELINE_A303_OFF", "FAVORS_GLAP_A303_ON"]},
            "rationale": {"type": "string", "minLength": 20, "maxLength": 2000},
            "decided_by_named_study_owner": {"const": true},
            "decided_on_sydney_date": {"type": "string", "format": "date"}
          }
        }
      ]
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original_reviews_immutable", "original_review_count", "adjudication_is_not_a_fifth_review",
        "raw_review_result_remains_authoritative", "resolution_is_separate_disposition",
        "append_new_record_for_resolution"
      ],
      "properties": {
        "original_reviews_immutable": {"const": true},
        "original_review_count": {"const": 4},
        "adjudication_is_not_a_fifth_review": {"const": true},
        "raw_review_result_remains_authoritative": {"const": true},
        "resolution_is_separate_disposition": {"const": true},
        "append_new_record_for_resolution": {"const": true}
      }
    },
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supports", "does_not_support"],
      "properties": {
        "supports": {"const": ["GOVERNED_DECISION_QUALITY_ADJUDICATION_RECORD"]},
        "does_not_support": {
          "const": [
            "BUSINESS_OUTCOME_EFFECT", "REAL_LOGISTICS_PERFORMANCE", "A303_REACTIVATION",
            "MODEL_PROMOTION", "PRODUCTION_READINESS", "OPERATIONAL_AUTHORITY"
          ]
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile", "network_access_allowed", "aws_write_allowed", "review_mutation_allowed",
        "action_authority", "policy_activation_allowed", "model_promotion_allowed",
        "production_effect", "a303_reactivation_allowed"
      ],
      "properties": {
        "profile": {"const": "LOCAL_EVALUATION_GOVERNANCE_ONLY"},
        "network_access_allowed": {"const": false},
        "aws_write_allowed": {"const": false},
        "review_mutation_allowed": {"const": false},
        "action_authority": {"const": "NONE"},
        "policy_activation_allowed": {"const": false},
        "model_promotion_allowed": {"const": false},
        "production_effect": {"const": false},
        "a303_reactivation_allowed": {"const": false}
      }
    }
  }
}
