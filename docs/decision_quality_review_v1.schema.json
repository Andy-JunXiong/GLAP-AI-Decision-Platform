{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glap.example/contracts/decision-quality-review.v1.schema.json",
  "title": "GLAP blinded decision quality review v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "package_digest",
    "rubric_version",
    "reviewer_ref",
    "reviewed_at",
    "attestations",
    "option_scores",
    "preferred_option",
    "confidence"
  ],
  "properties": {
    "schema_version": {"const": "decision-quality-review.v1"},
    "review_id": {"type": "string", "minLength": 1},
    "package_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "rubric_version": {"const": "decision-quality-rubric.v1"},
    "reviewer_ref": {"type": "string", "pattern": "^reviewer-[a-z0-9][a-z0-9-]{2,63}$"},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "attestations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["independent_review", "conflict_of_interest", "blind_key_access"],
      "properties": {
        "independent_review": {"const": true},
        "conflict_of_interest": {"const": false},
        "blind_key_access": {"const": false}
      }
    },
    "option_scores": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["option_id", "dimension_scores"],
        "properties": {
          "option_id": {"pattern": "^OPTION_[A-Z]$"},
          "dimension_scores": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidence_grounding",
              "risk_detection_and_proportionality",
              "policy_compliance",
              "actionability",
              "authority_compliance"
            ],
            "properties": {
              "evidence_grounding": {"type": "integer", "minimum": 0, "maximum": 4},
              "risk_detection_and_proportionality": {"type": "integer", "minimum": 0, "maximum": 4},
              "policy_compliance": {"type": "integer", "minimum": 0, "maximum": 4},
              "actionability": {"type": "integer", "minimum": 0, "maximum": 4},
              "authority_compliance": {"type": "integer", "minimum": 0, "maximum": 4}
            }
          }
        }
      }
    },
    "preferred_option": {"enum": ["OPTION_A", "OPTION_B", "TIE"]},
    "confidence": {"type": "integer", "minimum": 1, "maximum": 5},
    "review_notes": {"type": "string", "maxLength": 1000}
  }
}
