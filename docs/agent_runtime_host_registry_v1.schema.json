{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glap.example/contracts/agent-runtime-host-registry.v1.schema.json",
  "title": "GLAP Agent Runtime local host registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "interface_version", "execution_boundary", "registrations", "claim_boundary"],
  "properties": {
    "schema_version": {"const": "agent-runtime-host-registry.v1"},
    "interface_version": {"const": "agent-runtime.v1"},
    "execution_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "network_access_allowed", "operational_writes_allowed", "dynamic_dependency_install_allowed"],
      "properties": {
        "mode": {"const": "LOCAL_READ_ONLY"},
        "network_access_allowed": {"const": false},
        "operational_writes_allowed": {"const": false},
        "dynamic_dependency_install_allowed": {"const": false}
      }
    },
    "registrations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/registration"}
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported", "not_supported"],
      "properties": {
        "supported": {
          "type": "array",
          "const": ["REGISTERED_SOURCE_INTEGRITY", "DISTINCT_LOCAL_IMPLEMENTATION_PATHS", "FROZEN_BUNDLE_REPLAY_PARITY"]
        },
        "not_supported": {
          "type": "array",
          "const": ["HOST_AUTHENTICATION", "MODEL_IDENTITY", "HOST_QUALITY_SUPERIORITY", "OPERATIONAL_APPROVAL", "ACTION_CREATION", "DEPLOYED_RUNTIME_VERIFICATION", "PRODUCTION_READINESS"]
        }
      }
    }
  },
  "$defs": {
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_version", "implementation_id", "implementation_group", "module_path", "entrypoint", "source_sha256", "enabled_capabilities", "execution_boundary"],
      "properties": {
        "adapter_version": {"enum": ["deterministic-reference-adapter-a.v1", "independent-registered-adapter.v1"]},
        "implementation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
        "implementation_group": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
        "module_path": {"type": "string", "pattern": "^ops/agent_runtime_adapters/[a-z0-9_]+\\.py$"},
        "entrypoint": {"const": "run_adapter"},
        "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "enabled_capabilities": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["EXTERNAL_EVIDENCE", "DECISION_MEMORY"]}
        },
        "execution_boundary": {"const": "EVALUATION_NO_MUTATION"}
      }
    }
  }
}
